[Unit]
Description=Outlook IMAP pickup (loopback)
After=network.target

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/outlook-pickup
EnvironmentFile=/home/ubuntu/outlook-pickup/.env
ExecStart=/usr/bin/python3 /home/ubuntu/outlook-pickup/server.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
